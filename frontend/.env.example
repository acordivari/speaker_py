# Copy this file to `.env` (which is gitignored) and fill in the value.
#
#   cp frontend/.env.example frontend/.env
#
# TAILSCALE_HOST — your machine's Tailscale MagicDNS hostname, used to enable
# remote testing over your tailnet. Find it with `tailscale status` or in the
# Tailscale admin console. When set, `npm run dev` binds to all network
# interfaces and adds this hostname to Vite's server.allowedHosts so the dev
# server accepts requests proxied/forwarded under that name. Leave unset for
# normal localhost-only development.
TAILSCALE_HOST=your-machine.tailXXXX.ts.net
